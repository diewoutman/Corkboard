<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Works around NETSDK1226: framework-reference prune data not yet published
         for this SDK patch version (10.0.111) at time of writing. Safe to remove
         once a newer SDK/package index resolves it. -->
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <UserSecretsId>51b18ddf-b833-4e3d-ac92-134ecc8d3751</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="TickerQ" />
    <PackageReference Include="TickerQ.Dashboard" />
    <PackageReference Include="TickerQ.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Corkboard.Application\Corkboard.Application.csproj" />
    <ProjectReference Include="..\Corkboard.Infrastructure\Corkboard.Infrastructure.csproj" />
    <ProjectReference Include="..\Corkboard.Domain\Corkboard.Domain.csproj" />
    <ProjectReference Include="..\Corkboard.Contracts\Corkboard.Contracts.csproj" />
  </ItemGroup>

</Project>
